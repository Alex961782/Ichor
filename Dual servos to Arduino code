#include <Servo.h>

Servo servo1;
Servo servo2;

// Track current positions globally
int centerPos = 90;

int input;

void setup() {

  Serial.begin(9600);
  delay(1000);
  
  servo1.attach(9);
  servo2.attach(10);

  Serial.print("Enter servo degrees: ");
  input = Serial.parseInt();

  // Initialize servos to center
  servo1.write(centerPos);
  servo2.write(centerPos);
  //servo2.write(currentPos2);
  
  // Print user guide in the Serial Monitor
  //printStatusHeader();
}

void loop() {

